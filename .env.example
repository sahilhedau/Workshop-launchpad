# Workshop Launchpad Configuration
# Copy this file to .env to configure local settings

# Server Port and Host
PORT=3000
HOST=localhost
NODE_ENV=development

# Campaign Constants
CAMPAIGN_GOAL=500
CAMPAIGN_DAYS=7
CAMPAIGN_BUDGET=2000
WORKSHOP_NAME="Build Your First AI Project in 60 Minutes"

# Public Landing URL (Used when generating WhatsApp share links)
# In development, points to the local registration gateway. In production, points to your live URL.
WORKSHOP_LANDING_URL=http://localhost:3000/register.html

# Storage and Persistence
DATA_STORE_PATH=./data/campaign-store.json
PERSIST_INTERVAL_MS=2000

# Security & CORS
ENABLE_CORS=true
ALLOWED_ORIGINS=*

# Optional Integrations (Leave empty in demo mode)
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/EXAMPLE/exec
# WHATSAPP_BUSINESS_API_KEY=your_key_here
# SLACK_NOTIFICATION_WEBHOOK=https://hooks.slack.com/services/...
